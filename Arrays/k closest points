class Solution:
    def kClosest(self, points: list[list[int]], k: int) -> list[list[int]]:
        dist=[]
        for point in points:
            x=point[0]
            y=point[1]
            d=x*x+y*y
            dist.append([d,point])
        dist.sort()
        ans=[]
        for i in range(k):
            ans.append(dist[i][1])
        return ans
        
