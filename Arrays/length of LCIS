class Solution:
    def findLengthOfLCIS(self, nums: list[int]) -> int:
        count=1
        maxcount=1
        for i in range(len(nums)-1):
            if nums[i+1]>nums[i]:
                count+=1
            else:
                count=1
            if count>maxcount:
                maxcount=count
        return maxcount
        
