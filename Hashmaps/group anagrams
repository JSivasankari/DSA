class Solution(object):
    def groupAnagrams(self, strs):
        groups = defaultdict(list)
        for words in strs:
            freq={}
            for ch in words:
                freq[ch]=freq.get(ch,0)+1
            key = tuple(sorted(freq.items()))
            groups[key].append(words)
        return list(groups.values())

        


        
        
