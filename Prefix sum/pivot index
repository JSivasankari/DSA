class Solution(object):
    def pivotIndex(self, nums):
        n=len(nums)
        prefix=[0]*(n+1)
        for i in range(n):
            prefix[i+1]=prefix[i]+nums[i]
        for i in range(n):
            left=prefix[i]
            right=prefix[n]-prefix[i+1]
            if left==right:
                return i
        return -1
        
